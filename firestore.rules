rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Managers: the only logins that can open Day report and Settings.
    // Keep this list the same as ADMIN_EMAILS in index.html (all lowercase).
    function isManager() {
      return signedIn() && ('email' in request.auth.token)
        && request.auth.token.email.lower() in ['feras.kastero@hotmail.com', 'ma.handlle@outlook.com'];
    }

    // Settings and bikes: every desk reads them, only managers change them.
    // "counters" (order and invoice numbers) is updated by every desk.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if (docId == 'counters' && signedIn()) || isManager();
    }

    // Day reports (cash counts): managers only.
    match /days/{docId} {
      allow read, write: if isManager();
    }

    // Orders, customers, bike codes and held tickets: every signed-in desk.
    match /{collection}/{docId} {
      allow read, write: if signedIn() && collection != 'config' && collection != 'days';
    }
  }
}
